    (unsigned int)newestIndex,
    (unsigned int)nearestIndex,
    (unsigned int)secondNearestIndex,
    (unsigned int)(
      ld2410CandidateEvidenceHistoryCount - 1
    ),
    nearestMeanRelativeDelta,
